PROJECT_NAME           = "MyTeams"
PROJECT_NUMBER         = "1.0"
PROJECT_BRIEF          = "Collaborative communication server and CLI client over TCP"
OUTPUT_DIRECTORY       = doc/doxygen
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_ANON_NSPACES   = YES

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
VERBATIM_HEADERS       = YES

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = NO

INPUT                  = README.md \
                         include \
                         src \
                         doc/doxygen/mainpage.md \
                         doc/RFC.md
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.hpp *.c *.cc *.cpp *.md
USE_MDFILE_AS_MAINPAGE = doc/doxygen/mainpage.md
EXCLUDE                = .git \
                         .vscode \
                         libs/myteams

FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = .

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_EXTRA_STYLESHEET  = doc_assets/theme/doxygen-awesome.css
HTML_COLORSTYLE        = LIGHT
HTML_COLORSTYLE_HUE    = 209
HTML_COLORSTYLE_SAT    = 255
HTML_COLORSTYLE_GAMMA  = 113
GENERATE_TREEVIEW      = YES
TREEVIEW_WIDTH         = 250

GENERATE_LATEX         = NO

HAVE_DOT               = NO
